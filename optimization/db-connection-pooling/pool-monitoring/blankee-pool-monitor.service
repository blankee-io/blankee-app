[Unit]
Description=Blankee App Database Connection Pool Monitor
Documentation=file:///var/www/html/budget/monitor_pool_internal.py
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/budget

# Environment setup
Environment="PYTHONPATH=/var/www/html/budget"
Environment="PATH=/usr/bin:/usr/local/bin"

# Main command
ExecStart=/usr/bin/python3 /var/www/html/budget/monitor_pool_internal.py

# Restart policy
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitInterval=300

# Resource limits (optional but recommended)
MemoryLimit=100M
CPUQuota=10%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blankee-pool-monitor

# Security hardening (optional)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/budget

[Install]
WantedBy=multi-user.target
