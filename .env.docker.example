# Blankee - docker compose settings. Copy to .env and fill in the three secrets.
#
#   cp .env.docker.example .env
#
# Generate the secrets:
#   MYSQL_ROOT_PASSWORD / DB_PASSWORD
#       openssl rand -base64 24
#   SECRET_KEY
#       python3 -c 'import secrets; print(secrets.token_hex(32))'
#   SETTINGS_ENCRYPTION_KEY
#       python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'

# --- required ---

# Signs session cookies. The container refuses to start without it, because the
# fallback is a per-worker random key: sessions would break on every restart and
# differ between workers.
SECRET_KEY=

MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# --- optional ---

# Encrypts the SMTP password stored in the app. Without it, email settings can
# be saved but no password can be kept, so notifications cannot send. Changing
# it later makes an already-stored password undecryptable.
SETTINGS_ENCRYPTION_KEY=

# The address the app builds links with, in password-reset emails among others.
# Must match how people actually reach it, including the port.
APP_URL=http://localhost:18420

# Host port. Chosen to be uncommon: clear of 3000/5000/8000/9000, and below the
# 32768 mark where Linux starts allocating ephemeral ports. The container always
# listens on 8000 internally, whatever this is set to.
HTTP_PORT=18420

DB_NAME=blankee
DB_USER=blankee

# Bank connections (SimpleFIN Bridge) and AI categorization (Claude). Each user
# connects their own SimpleFIN account and Anthropic key from inside the app,
# so nothing is needed here; set either to 'null' to remove the feature.
#BANK_PROVIDER=simplefin
#ENRICHMENT_PROVIDER=claude

# Push notifications for the iOS app. All four are needed, or no push is
# sent; the in-app list and the emails are unaffected. Create a key with the
# Apple Push Notifications service enabled at developer.apple.com under
# Certificates, Identifiers & Profiles > Keys, and mount the .p8 it gives you
# into the container. APNS_TOPIC is the app's bundle identifier.
# APNS_USE_SANDBOX=true for builds installed from Xcode or TestFlight;
# false for the App Store build. A token from one is rejected by the other.
# Without APNS_ settings of its own, the server asks the relay to push
# instead; it never sees the notification's text. Empty = no pushes.
PUSH_RELAY_URL=https://push.blankee.io

#APNS_KEY_PATH=/run/secrets/apns.p8
#APNS_KEY_ID=
#APNS_TEAM_ID=
#APNS_TOPIC=io.blankee.blankee
#APNS_USE_SANDBOX=false
