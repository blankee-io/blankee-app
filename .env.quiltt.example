# Quiltt.io Integration Environment Variables
# Copy this file to .env and fill in your actual values
# Get these from https://dashboard.quiltt.dev

# Quiltt API Key (for backend operations)
QUILTT_API_KEY=your_api_key_here

# Quiltt Environment ID (for Quiltt Connector)
QUILTT_ENVIRONMENT_ID=your_environment_id_here

# Quiltt Webhook Secret (optional, for webhook signature verification)
QUILTT_WEBHOOK_SECRET=your_webhook_secret_here

# Quiltt Mode (development or production)
QUILTT_MODE=development
